{
  "name": "cofilmery",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:live": "VITE_AI_MODE=live vite",
    "build": "vite build",
    "build:staging": "VITE_AI_MODE=live vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "deploy": "npm run build && wrangler pages deploy dist --project-name cofilmery",
    "deploy:staging": "npm run build:staging && wrangler pages deploy dist --project-name cofilmery-staging --config wrangler.staging.jsonc",
    "dev:sandbox": "wrangler pages dev dist --ip 0.0.0.0 --port 3000",
    "dev:sandbox:staging": "VITE_AI_MODE=live wrangler pages dev dist --ip 0.0.0.0 --port 3000",
    "db:migrate:local": "wrangler d1 migrations apply cofilmery-production --local",
    "db:migrate:prod": "wrangler d1 migrations apply cofilmery-production",
    "db:migrate:staging": "wrangler d1 migrations apply cofilmery-staging --config wrangler.staging.jsonc",
    "db:migrate:staging:local": "wrangler d1 migrations apply cofilmery-staging --local",
    "db:seed": "wrangler d1 execute cofilmery-production --local --file=./seed.sql",
    "secret:staging": "wrangler pages secret put OPENROUTER_API_KEY --project-name cofilmery-staging"
  },
  "dependencies": {
    "@radix-ui/react-avatar": "^1.1.2",
    "@radix-ui/react-checkbox": "^1.1.3",
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-dropdown-menu": "^2.1.4",
    "@radix-ui/react-progress": "^1.1.1",
    "@radix-ui/react-select": "^2.1.4",
    "@radix-ui/react-separator": "^1.1.1",
    "@radix-ui/react-slider": "^1.2.2",
    "@radix-ui/react-tabs": "^1.1.2",
    "@radix-ui/react-tooltip": "^1.1.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "hono": "^4.13.3",
    "lucide-react": "^0.474.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.54.2",
    "react-router-dom": "^6.28.0",
    "recharts": "^2.13.3",
    "tailwind-merge": "^2.5.5",
    "zod": "^3.24.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260822.1",
    "@hono/vite-cloudflare-pages": "^0.4.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "wrangler": "^4.110.0"
  }
}
