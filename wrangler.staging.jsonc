{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cofilmery-staging",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "pages_build_output_dir": "./dist",

  // Staging D1 database (separate from production)
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cofilmery-staging",
      "database_id": "881f5d21-5ba7-4dec-9f81-3cee45e89b0c"
    }
  ],

  // R2 object storage — shared bucket, staging uses a /staging/ prefix in keys
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "cofilmery-assets"
    }
  ]

  // OPENROUTER_API_KEY must be set as a Cloudflare secret:
  //   wrangler pages secret put OPENROUTER_API_KEY --project-name cofilmery-staging
  // It must NOT appear here.
}
