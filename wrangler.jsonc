{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cofilmery",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "pages_build_output_dir": "./dist",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cofilmery-staging",
      "database_id": "881f5d21-5ba7-4dec-9f81-3cee45e89b0c"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "cofilmery-assets"
    }
  ]
}
